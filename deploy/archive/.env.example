ARCHIVE_HTTP_PORT=12581
# Telegram 应用凭据，从 https://my.telegram.org 获取
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate three different secrets; never reuse the forwarding deployment's secrets.
ARCHIVE_DB_PASSWORD=replace-with-a-random-database-password
ARCHIVE_REDIS_PASSWORD=replace-with-a-random-redis-password
ARCHIVE_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ARCHIVE_MIN_FREE_BYTES=268435456
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
