FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY requirements-pg.txt .
RUN pip install --no-cache-dir -r requirements-pg.txt
COPY . .
EXPOSE 9099
CMD ["python", "archive_entrypoint.py"]
